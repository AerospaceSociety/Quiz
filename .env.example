# Quizzitch Environment Variables Template
# Copy this file to .dev.vars (for Cloudflare Pages / local development) or .env

# Server Secrets (never committed to git or exposed to browser)
JOTFORM_API_KEY=your_jotform_api_key_here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
RETENTION_PURGE_TOKEN=your_random_purge_token_here

# Firebase Web Client Configuration (injected during static build or loaded from config/settings.local.json)
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_web_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudflare Pages Runtime Settings
ALLOWED_ORIGINS=https://quiz.pages.dev,http://localhost:8788
PORT=8080

#Update
