# Cloudflare Pages / Netlify response headers.
# The <meta> CSP in each page covers static hosts that cannot set headers (GitHub Pages);
# these headers add what a <meta> tag cannot: frame-ancestors, HSTS and Permissions-Policy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow

/index.html
  Permissions-Policy: camera=(self), microphone=(self), fullscreen=(self), keyboard-map=(self), display-capture=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://www.gstatic.com 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://cdn.jsdelivr.net https://storage.googleapis.com https://submit.jotform.com https://api.jotform.com; object-src 'none'; base-uri 'self'; form-action 'self' https://submit.jotform.com; frame-ancestors 'none'

/
  Permissions-Policy: camera=(self), microphone=(self), fullscreen=(self), keyboard-map=(self), display-capture=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://www.gstatic.com 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://cdn.jsdelivr.net https://storage.googleapis.com https://submit.jotform.com https://api.jotform.com; object-src 'none'; base-uri 'self'; form-action 'self' https://submit.jotform.com; frame-ancestors 'none'

/admin.html
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-store

/config/*
  Cache-Control: no-store
