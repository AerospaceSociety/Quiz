rules_version = '2';

// ============================================================================
// QUIZZITCH · CelesteCon 2026 · Firestore security rules (project quizzitch-14998)
//
// Principals
//   candidate — Firebase anonymous auth; may only touch documents keyed by its own uid.
//   admin     — email/password account whose uid has a document in /admins.
//               Create those documents by hand in the Firebase console; no client can.
//
// Deploy:  firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // ── Invigilator allowlist ────────────────────────────────────────────────
    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // ── Paper release / end / extension ──────────────────────────────────────
    match /exam_control/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Question bank: only the Pages API returns a candidate's assigned paper ──
    match /quizzitch_questions/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Answer key: invigilators only, never candidates ──────────────────────
    match /answer_key/{doc} {
      allow read, write: if isAdmin();
    }

    // ── Registration records: private to invigilators ────────────────────────
    match /registrations/{schoolUid} {
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Authoritative roster: candidate claims are validated by the Pages API ─
    match /roster/{key} {
      allow read, write: if isAdmin();
    }

    match /candidate_claims/{uid} {
      allow read, write: if isAdmin();
    }

    match /candidate_papers/{uid} {
      allow read, write: if isAdmin();
    }

    match /privacy_controls/{doc} {
      allow get: if signedIn() && doc == 'stills';
      allow list: if false;
      allow write: if isAdmin();
    }

    // ── Identity locks: all candidate changes go through the authenticated API ─
    match /identities/{key} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    // ── Clock handshake scratch document ─────────────────────────────────────
    match /time_sync/{uid} {
      allow read, write: if false;
    }

    // ── Live session state: candidate writes are validated by the Pages API ──
    match /sessions/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Live activity feed: deterministic doc ids ${uid}_${seq}, seq 0..79 ────
    match /events/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    // ── Forensic record: baseline, stills, full ledger ───────────────────────
    // Candidate forensic writes and final sealing are validated by the Pages API.
    match /forensics/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    // ── Sealed submissions: create-once, immutable, invigilator-readable ─────
    match /submissions/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin();
    }
  }
}
